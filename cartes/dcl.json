{
  "id": "dcl",
  "titre": "Droit des contrats de la Common law",
  "langue": "fr",
  "statut_maquette": "ORL",
  "complement": false,
  "officiel": {
    "semestres": "S6 (LLA6J7B, CM 10 h + TD 10 h, 3 ECTS)",
    "enseignant": "Isabelle Noël",
    "description": "Vocabulaire et mécanismes des contrats anglo-saxons courants dans le commerce international ; common law, equity, UCC, influence du droit européen, conséquences du Brexit ; systèmes judiciaires anglais, britannique et américain.",
    "bibliographie": [
      "E. Boyé, L'anglais des contrats internationaux, LexisNexis",
      "M. Harvey, C. Kirby-Legier, M. Charret-Del Bove, Droit anglais et droit américain, Armand Colin",
      "S. Azzouz, Contract Law, Ophrys"
    ],
    "sources": [
      "r.orleans-l3-s6",
      "r.lille-l3-tci"
    ]
  },
  "cadres": [
    "Stare decisis",
    "Equity",
    "UCC article 2",
    "Hadley v Baxendale (1854)"
  ],
  "competences_examen": [
    "Expliquer la formation d'un contrat en common law",
    "Qualifier une clause (condition, warranty, innominate term)",
    "Choisir un remède en cas de breach",
    "Traduire et expliquer le vocabulaire contractuel anglais"
  ],
  "incertitudes": [
    "L'« influence du droit européen » figure dans le descriptif officiel mais n'a pas de chapitre propre : elle est traitée dans dcl.juridictions (Brexit)."
  ],
