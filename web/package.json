{
  "name": "lea-study",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "db:sync": "tsx --env-file=.env scripts/sync.ts",
    "db:migrate:deploy": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "d3-force": "^3.0.1",
    "drizzle-orm": "^0.45.4",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "22.x"
  }
}
